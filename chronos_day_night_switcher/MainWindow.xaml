<Window x:Class="Chronos_Day_and_Night_Switcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Chronos_Day_and_Night_Switcher"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        mc:Ignorable="d"
        Title="Chronos Day and Night Switcher" 
        Height="450" Width="800"
        WindowStyle="None"
        ShowInTaskbar="False"
        Visibility="Hidden">

    <Window.Resources>
        <ContextMenu x:Key="TrayContextMenu">
            <MenuItem Header="Resume Automatic Switching"
                  Click="OnAutomaticResume" />

            <Separator />

            <MenuItem Header="Light Mode"
                  Click="OnForceLightClick" />

            <MenuItem Header="Dark Mode"
                  Click="OnForceDarkClick" />

            <Separator />

            <MenuItem Header="Change App Theme"
                  IsCheckable="True"
                  IsChecked="True"
                  Click="OnAppThemeChange" />

            <MenuItem Header="Change System Theme"
                  IsCheckable="True"
                  IsChecked="True"
                  Click="OnSystemThemeChange" />

            <Separator />

            <MenuItem Header="Exit Chronos"
                  Click="OnTerminationClick" />
        </ContextMenu>
    </Window.Resources>
    <Grid>
    </Grid>
</Window>